# Copia este fichero a .env.local (no se sube al repositorio).

# --- Datos de mercado ---
# EODHD: precios del backtest y buscador de activos (/api/search y Mi cartera).
EODHD_API_TOKEN=

# --- Puerta del Laboratorio K ---
# Secreto compartido con el portal de Ataraxia: valida la entrada de los socios y firma su identidad (cookie epk-socio).
ATARAXIA_LAB_SECRET=

# --- Mi cartera ---
# Importar cartera desde una captura (POST /api/cartera/importar). Sin clave, el resto de la app funciona y la importación responde 503.
ANTHROPIC_API_KEY=

# Opcional: modelo de visión de la importación. Por defecto claude-opus-5.
ANTHROPIC_MODEL=

# Solo desarrollo: ruta a un JSON con una extracción ya hecha, para probar la importación sin gastar API. Se ignora en producción.
IMPORTAR_SIMULACION=

# Enlace de la masterclass «El arte del rebalanceo» que se enseña en Mi plan.
NEXT_PUBLIC_ENLACE_MASTERCLASS_REBALANCEO=https://hub.elproyectok.com/course/ataraxia
